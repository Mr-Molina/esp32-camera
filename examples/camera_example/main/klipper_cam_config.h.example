#ifndef _KLIPPER_CAM_CONFIG_H_
#define _KLIPPER_CAM_CONFIG_H_

#ifdef __cplusplus
extern "C" {
#endif

/*
 * Wi-Fi Credentials
 * Replace with your local 2.4GHz Wi-Fi network SSID and password.
 */
#ifndef CONFIG_KLIPPER_CAM_WIFI_SSID
#define CONFIG_KLIPPER_CAM_WIFI_SSID "YOUR_WIFI_SSID"
#endif

#ifndef CONFIG_KLIPPER_CAM_WIFI_PASS
#define CONFIG_KLIPPER_CAM_WIFI_PASS "YOUR_WIFI_PASSWORD"
#endif

/*
 * Network Configuration
 * Set CONFIG_KLIPPER_CAM_USE_DHCP to 1 for automatic DHCP lease, or 0 for static IP.
 */
#define CONFIG_KLIPPER_CAM_USE_DHCP       1
#define CONFIG_KLIPPER_CAM_STATIC_IP      "10.0.0.150"
#define CONFIG_KLIPPER_CAM_STATIC_GW      "10.0.0.1"
#define CONFIG_KLIPPER_CAM_STATIC_NETMASK "255.255.255.0"
#define CONFIG_KLIPPER_CAM_STATIC_DNS     "10.0.0.1"

/*
 * Camera Hardware & Orientation
 */
#define CONFIG_KLIPPER_CAM_VFLIP    0   /* 1 = Invert vertical (for upside-down bed/gantry mounts) */
#define CONFIG_KLIPPER_CAM_HMIRROR  0   /* 1 = Invert horizontal */
#define CONFIG_KLIPPER_CAM_QUALITY  12  /* JPEG quality (0-63, lower is higher quality) */

#ifdef __cplusplus
}
#endif

#endif /* _KLIPPER_CAM_CONFIG_H_ */
