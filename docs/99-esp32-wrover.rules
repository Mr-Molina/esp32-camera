# Deterministic binding, ModemManager exclusion, and HUPCL DTR-reset suppression for ESP32-WROVER-DEV (CH340 1a86:7523)
SUBSYSTEM=="tty", ATTRS{idVendor}=="1a86", ATTRS{idProduct}=="7523", ENV{ID_PATH}=="pci-0000:00:14.0-usb-0:12:1.0", SYMLINK+="ttyUSB-esp32", GROUP="dialout", MODE="0660", ENV{ID_MM_DEVICE_IGNORE}="1", ENV{ID_MM_CANDIDATE}="0", RUN+="/usr/bin/stty -F /dev/%k -hupcl"
