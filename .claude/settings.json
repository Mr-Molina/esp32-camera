{
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git log:*)",
      "Bash(git diff:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git fetch:*)",
      "Bash(cargo fmt:*)",
      "Bash(cargo clippy:*)",
      "Bash(cargo test:*)",
      "Bash(cargo build:*)",
      "Bash(cargo check:*)",
      "Bash(ruff check:*)",
      "Bash(ruff format:*)",
      "Bash(pytest:*)"
    ],
    "deny": [
      "Read(./target/**)",
      "Read(./.env.local)",
      "Read(./.env*.local)"
    ]
  },
  "extraKnownMarketplaces": {
    "tokeneconomizer": {
      "source": {
        "source": "github",
        "repo": "microsoft/TokenEconomizer"
      }
    },
    "superpowers-dev": {
      "source": {
        "source": "github",
        "repo": "Mr-Molina/superpowers"
      }
    }
  },
  "enabledPlugins": {
    "tokeneconomizer@tokeneconomizer": true,
    "superpowers@superpowers-dev": true
  }
}
