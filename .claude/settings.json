{
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git log:*)",
      "Bash(git diff:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git fetch:*)",
      "Bash(cargo fmt:*)",
      "Bash(cargo clippy:*)",
      "Bash(cargo test:*)",
      "Bash(cargo build:*)",
      "Bash(cargo check:*)",
      "Bash(cargo fetch:*)",
      "Bash(cargo tree:*)",
      "Bash(cargo metadata:*)",
      "Bash(cargo deny:*)",
      "Bash(cargo audit:*)",
      "Bash(cargo miri:*)",
      "Bash(cargo +nightly miri:*)",
      "Bash(cargo +esp clippy:*)",
      "Bash(cargo +esp build:*)",
      "Bash(cargo +esp fw:*)",
      "Bash(cargo +esp fw-check:*)",
      "Bash(cargo xtask --help:*)",
      "Bash(cargo xtask verify-invariants:*)",
      "Bash(cargo xtask verify-pure-rust:*)",
      "Bash(cargo xtask build-bootloader:*)",
      "Bash(cargo xtask wrap-esp-image-elf:*)",
      "Bash(cargo xtask bootstrap-env --help:*)",
      "Bash(cargo run --package xtask -- verify-invariants:*)",
      "Bash(cargo run --package xtask -- verify-pure-rust:*)",
      "Bash(cargo run -p xtask -- verify-invariants:*)",
      "Bash(cargo run -p xtask -- verify-pure-rust:*)",
      "Bash(git worktree list:*)",
      "Bash(git ls-files:*)",
      "Bash(git check-ignore:*)",
      "Bash(rustup show:*)",
      "Bash(rustup toolchain list:*)",
      "Bash(gh run list:*)",
      "Bash(gh run view:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr view:*)",
      "Bash(pre-commit run:*)"
    ],
    "deny": [
      "Read(./target/**)",
      "Read(./.env.local)",
      "Read(./.env*.local)",
      "Read(./.agents/**)",
      "Bash(cargo xtask ota-deploy:*)",
      "Bash(cargo xtask ensure-serial-passive:*)",
      "Bash(cargo run --target xtensa-esp32-none-elf:*)",
      "Bash(espflash flash:*)",
      "Bash(espflash write-bin:*)",
      "Bash(espflash erase-flash:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)"
    ]
  },
  "extraKnownMarketplaces": {
    "tokeneconomizer": {
      "source": {
        "source": "github",
        "repo": "microsoft/TokenEconomizer"
      }
    },
    "superpowers-dev": {
      "source": {
        "source": "github",
        "repo": "Mr-Molina/superpowers"
      }
    }
  },
  "enabledPlugins": {
    "tokeneconomizer@tokeneconomizer": true,
    "superpowers@superpowers-dev": true
  }
}
